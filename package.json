{
  "name": "solace-diaries",
  "version": "2.0.0",
  "private": true,
  "description": "A private AI journal with semantic memory and grounded reflection.",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "npm run db:up && concurrently -n api,web -c yellow,cyan \"npm:dev -w @solace/api\" \"npm:dev -w @solace/web\"",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate -w @solace/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build --workspaces --if-present",
    "e2e": "npm run e2e -w @solace/web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  }
}
