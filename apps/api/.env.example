# ── Required ─────────────────────────────────────────────
# Postgres with pgvector. Local: `npm run db:up` (docker) or `npx supabase start` (port 55322).
DATABASE_URL=postgres://solace:solace@localhost:55432/solace
# Supabase project (auth verification + private photo storage).
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=
# Exact origin of the web app (CORS). Comma-separate to allow several.
WEB_ORIGIN=http://localhost:5173

# ── AI ───────────────────────────────────────────────────
# Server Gemini key. Users may also bring their own key from Settings.
GEMINI_API_KEY=
# Billing tier of that key: free (default) or paid. On free, Google may use what is sent to
# improve its products and each model allows only a small number of requests per day per
# project, and that limit is SHARED across all users: one heavy user can use up a model for
# everyone, so keep the per-user budgets below small. GET /api/me/usage reports this tier to
# signed-in users. The public web pages (landing, privacy) read the web build's own
# VITE_AI_TIER instead, which is NOT derived from this value: change both together.
AI_TIER=free
# Default generation model, for any task without its own model below.
GEMINI_CHAT_MODEL=gemini-2.5-flash
# One model per task. Free-tier quotas are per model, so separate models give each task its
# own daily allowance; on a paid key they can all be the same model. Empty = GEMINI_CHAT_MODEL.
#   ENRICH: one structured call per entry (mood, tags, summary, memories, constellation)
#   CHAT:   Reflect answers (streamed)
#   BATCH:  weekly letters, daily prompts (and later chapters and notes)
#   VISION: photo descriptions
#   Recommended routing (checked live): gemini-3.6-flash returned 503 "high demand" and
#   gemini-3.8-flash streamed nothing for 90s, so neither is used.
GEMINI_MODEL_ENRICH=gemini-3.5-flash-lite
GEMINI_MODEL_CHAT=gemini-2.5-flash
GEMINI_MODEL_BATCH=gemini-3.1-flash-lite
GEMINI_MODEL_VISION=gemini-3.1-flash-lite
# Embeddings have their own quota. Changing this model means re-embedding everything and
# re-calibrating the thresholds below.
GEMINI_EMBED_MODEL=gemini-embedding-001
# Streamed answers (Reflect): give up when no text arrives within this long (ms), so a stalled
# model ends in an error in seconds, not at the whole-stream timeout. 0 turns it off.
AI_FIRST_TOKEN_MS=20000
# Per-user daily budget of interactive AI calls (search, Reflect, letters, prompts) on the server key.
# Code default 200 suits a paid key. On AI_TIER=free use about 25: the provider's daily limit is
# shared by all users, so a large per-user budget lets one person exhaust it for everyone.
AI_DAILY_QUOTA=200
# Background entry analyses per user per day (separate from the budget above); extra runs wait until the next UTC day.
# Code default 150 suits a paid key; on the free tier use about 40 (same reason).
ENRICH_DAILY_QUOTA=150
# Quiet time after the last save before an entry is analysed (ms). Longer = fewer calls per writing session.
ENRICH_DEBOUNCE_MS=20000

# Retrieval thresholds, calibrated for gemini-embedding-001 at 768 dims.
SEARCH_MIN_SIMILARITY=0.6
SEARCH_RELATIVE_BAND=0.08
MEMORY_DEDUPE_SIMILARITY=0.93

# ── Parental-consent email (teen accounts, 13-17) ────────
# Pick one transport. With neither set, mail only goes to the log and, in production,
# teen sign-up is switched off (the age gate answers 503 teen_signup_unavailable).
#   Resend (production): RESEND_API_KEY + a verified sender in MAIL_FROM.
#   Brevo (free, no domain): BREVO_API_KEY + the single sender verified in Brevo in MAIL_FROM.
#   SMTP (local Mailpit): SMTP_HOST=127.0.0.1, SMTP_PORT=55325 (Supabase local stack).
RESEND_API_KEY=
BREVO_API_KEY=
MAIL_FROM=Solace Diaries <no-reply@your-domain.example>
SMTP_HOST=
SMTP_PORT=55325

# ── Optional ─────────────────────────────────────────────
# Only for Supabase projects still on the legacy HS256 JWT secret (local CLI stack uses it).
SUPABASE_JWT_SECRET=
PORT=8787
LOG_LEVEL=info
# Run the background enrichment worker inside this process (default true).
RUN_WORKER=true
