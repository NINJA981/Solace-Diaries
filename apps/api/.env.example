# ── Required ─────────────────────────────────────────────
# Postgres with pgvector. Local: `npm run db:up` (docker) or `npx supabase start` (port 55322).
DATABASE_URL=postgres://solace:solace@localhost:55432/solace
# Supabase project (auth verification + private photo storage).
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=
# Exact origin of the web app (CORS). Comma-separate to allow several.
WEB_ORIGIN=http://localhost:5173

# ── AI ───────────────────────────────────────────────────
# Server Gemini key. Users may also bring their own key from Settings.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Per-user daily AI call budget when using the server key.
AI_DAILY_QUOTA=200
# Background entry analyses per user per day (separate from the budget above); extra runs wait until the next UTC day.
ENRICH_DAILY_QUOTA=150

# Retrieval thresholds, calibrated for gemini-embedding-001 at 768 dims.
SEARCH_MIN_SIMILARITY=0.6
SEARCH_RELATIVE_BAND=0.08
MEMORY_DEDUPE_SIMILARITY=0.93

# ── Optional ─────────────────────────────────────────────
# Only for Supabase projects still on the legacy HS256 JWT secret (local CLI stack uses it).
SUPABASE_JWT_SECRET=
PORT=8787
LOG_LEVEL=info
# Run the background enrichment worker inside this process (default true).
RUN_WORKER=true
