datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  entries          JournalEntry[]
  memoryFragments  MemoryFragment[]
  proactivePrompts ProactivePrompt[]
  memories         Memory[]
  graphEntities    GraphEntity[]
  graphRelationships GraphRelationship[]
}

model JournalEntry {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String        @db.Text
  mood      String
  tags      String[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  vectors   VectorRecord[]
  memorySources MemoryFragmentSource[]
  images    ImageAsset[]
  chunks    JournalChunk[]
  searchVector  Unsupported("tsvector")? @map("search_vector")
}

model JournalChunk {
  id         String       @id @default(uuid())
  entryId    String
  entry      JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  content    String       @db.Text
  chunkIndex Int
  vector     Unsupported("vector(768)")?
  createdAt  DateTime     @default(now())
}

model ImageAsset {
  id          String       @id @default(uuid())
  entryId     String
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  imageUrl    String
  description String?      @db.Text
  createdAt   DateTime     @default(now())
}

model VectorRecord {
  id        String       @id @default(uuid())
  entryId   String
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId    String
  vector    Unsupported("vector(768)")?
  createdAt DateTime     @default(now())
}

model MemoryFragment {
  id               String                 @id @default(uuid())
  userId           String
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         String
  content          String                 @db.Text
  strength         Int                    @default(1)
  status           String                 @default("active")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  sourceEntries    MemoryFragmentSource[]
  proactivePrompts ProactivePrompt[]
}

model MemoryFragmentSource {
  id               String         @id @default(uuid())
  memoryFragmentId String
  memoryFragment   MemoryFragment @relation(fields: [memoryFragmentId], references: [id], onDelete: Cascade)
  entryId          String
  entry            JournalEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
}

model ProactivePrompt {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  memoryFragmentId String?
  memoryFragment   MemoryFragment? @relation(fields: [memoryFragmentId], references: [id], onDelete: SetNull)
  promptText       String          @db.Text
  triggerType      String
  scheduledFor     DateTime
  isDelivered      Boolean         @default(false)
  deliveredAt      DateTime?
  userResponse     String?         @db.Text
  createdAt        DateTime        @default(now())
}

model Memory {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  confidence Float
  vector     Unsupported("vector(768)")?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model GraphEntity {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String             // "people" | "places" | "projects" | "goals" | "habits" | "emotions"
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  
  sourceRelationships GraphRelationship[] @relation("SourceEntity")
  targetRelationships GraphRelationship[] @relation("TargetEntity")

  @@unique([userId, name, type])
}

model GraphRelationship {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId   String
  source     GraphEntity @relation("SourceEntity", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId   String
  target     GraphEntity @relation("TargetEntity", fields: [targetId], references: [id], onDelete: Cascade)
  type       String      // e.g. "triggers" | "improves" | "hinders" | "relates_to" | "participates_in"
  strength   Int         @default(1)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([userId, sourceId, targetId, type])
}
